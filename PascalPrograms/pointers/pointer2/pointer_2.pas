program DynamicVarsDemo;

var
    p, q: ^string;
    s: string;

begin
    new(p);
    write('Введите строку для новой динамической переменной: ');
    readln(s);
    p^ := s;
    writeln('p^ = ', p^);

    writeln;
    q := p;
    writeln('Выполнили q := p. Теперь q^ = ', q^, ' - это та же самая область памяти, что и p^');

    writeln;
    write('Изменим значение через q^. Введите новую строку: ');
    readln(q^);
    writeln('Теперь p^ тоже изменился и равен: "', p^, '"');
    writeln('(p и q - разные переменные-указатели, но обе хранят один и тот же адрес)');

    writeln;
    dispose(q);
    writeln('Выполнили dispose(q) - память вернулась в кучу.');
    writeln('Значение самого указателя q при этом не изменилось, но обращаться');
    writeln('к q^ или к p^ больше нельзя - оба указателя теперь "висячие" (dangling).');

    writeln;
    writeln('Демонстрация утечки памяти:');
    new(p);
    p^ := 'первая строка';
    writeln('Выделили память под p, записали: "', p^, '"');

    new(p);
    p^ := 'вторая строка';
    writeln('Выделили ещё раз под тот же указатель p, записали: "', p^, '"');
    writeln('Адрес первой динамической переменной был затёрт - теперь её невозможно');
    writeln('ни прочитать, ни освободить. Это и есть утечка памяти (мусор в куче).');

    writeln;
    dispose(p);
    writeln('Освободили последнюю выделенную переменную через dispose(p).');
    writeln('Первую освободить уже нельзя - адрес был потерян навсегда.')
end.
